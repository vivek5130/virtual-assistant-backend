PORT=7008
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.5seiqne.mongodb.net/?appName=Cluster0
# Long random string. Generate: openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Comma-separated browser origins allowed to call /api
CORS_ORIGINS=http://localhost:7007
# Single-merchant today; every record is merchant-scoped for multi-tenancy.
MERCHANT_ID=shopsmart

# Google sign-in: OAuth 2.0 Client ID (type "Web application") from
# console.cloud.google.com → APIs & Services → Credentials. Add your frontend
# origin (e.g. http://localhost:7007) to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=


# Seed script only (npm run seed)
ADMIN_EMAIL=admin@shopsmart.local
ADMIN_PASSWORD=change-me-please

# ---- AI assistant platform (this store is a merchant of it) ----
# Public URL of this storefront; product links sent to the platform use it.
STORE_PUBLIC_URL=http://localhost:7007
PLATFORM_API_URL=http://localhost:7010
# Secret server key from Dashboard → Developers → API keys (sk_live_…)
PLATFORM_API_KEY=
# Dashboard → Developers → Identity verification secret
PLATFORM_IDENTITY_SECRET=
